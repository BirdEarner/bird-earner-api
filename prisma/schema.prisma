generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

generator kysely {
  provider = "prisma-kysely"
  output   = "../types"
  fileName = "types.ts"
}

datasource db {
  provider = "postgresql"
}

model FAQ {
  id          String  @id
  question    String
  answer      String
  category    String  @default("General") @db.VarChar(50)
  keywords    String?
  youtubeLink String?

  @@index([question])
  @@index([keywords])
  @@map("faqTable")
}

model Admin {
  id               Int       @id @default(autoincrement())
  name             String    @db.VarChar(100)
  email            String    @unique @db.VarChar(255)
  password         String    @db.VarChar(255)
  role             AdminRole
  lastLoginAt      DateTime?
  lastLoginIp      String?   @db.VarChar(45)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contactResponses Contact[] @relation("AdminContacts")

  @@map("admins")
}

model Contact {
  id            String        @id @db.VarChar(36)
  ticketId      String        @unique @db.VarChar(20)
  name          String        @db.VarChar(255)
  email         String        @db.VarChar(255)
  phone         String?       @db.VarChar(50)
  subject       String        @db.VarChar(500)
  message       String
  isRead        Boolean       @default(false)
  status        ContactStatus @default(pending)
  adminResponse String?
  adminId       Int?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  admin         Admin?        @relation("AdminContacts", fields: [adminId], references: [id])

  @@index([adminId])
  @@index([createdAt])
  @@index([email])
  @@index([isRead])
  @@index([status])
  @@index([ticketId])
  @@map("contacts")
}

model User {
  id                       String                @id @default(uuid())
  email                    String                @unique
  password                 String?
  fullName                 String?
  isTestAccount            Boolean               @default(false)
  createdAt                DateTime              @default(now())
  updatedAt                DateTime              @updatedAt
  resetPasswordExpires     BigInt?
  resetPasswordToken       String?               @db.VarChar(255)
  mobile                   String?               @unique @db.VarChar(20)
  isEmailVerified          Boolean               @default(false)
  emailVerificationToken   String?               @db.VarChar(255)
  emailVerificationExpires BigInt?
  provider                 String                @default("email")
  providerAccountId        String?               @unique
  profilePhoto             String?
  dob                      DateTime?
  gender                   String?
  twoFactorEnabled         Boolean               @default(false)
  bankAccount              BankAccount?
  client                   Client?
  freelancer               Freelancer?
  jobBookmarks             JobBookmark[]
  receivedMessages         Message[]             @relation("UserReceiver")
  sentMessages             Message[]             @relation("UserSender")
  reviewsReceived          Review[]              @relation("UserReviewsReceived")
  reviewsGiven             Review[]              @relation("UserReviewsGiven")
  suggestedServices        SuggestedService[]
  twoFactorChallenges      twoFactorChallenges[]
  addresses                UserAddress[]
  userDevices              userDevices[]
  walletTransactions       WalletTransaction[]

  @@map("users")
}

model UserAddress {
  id         String    @id @default(uuid())
  userId     String
  label      String    @db.VarChar(50)
  line1      String    @db.VarChar(500)
  line2      String?   @db.VarChar(500)
  city       String?   @db.VarChar(100)
  state      String?   @db.VarChar(100)
  zipcode    String?   @db.VarChar(20)
  country    String?   @default("India") @db.VarChar(100)
  latitude   Decimal?  @db.Decimal(10, 8)
  longitude  Decimal?  @db.Decimal(11, 8)
  isDefault  Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, lastUsedAt])
  @@map("userAddresses")
}

model BankAccount {
  id                String   @id @default(uuid())
  userId            String   @unique
  bankName          String
  accountHolderName String
  accountNumber     String
  ifscCode          String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bankAccounts")
}

model Freelancer {
  id                    String              @id @default(uuid())
  userId                String              @unique
  phase1Completed       Boolean             @default(false)
  phase2Completed       Boolean             @default(false)
  selectedServices      Json?
  highestQualification  String?
  experience            Int?
  profileHeading        String?
  city                  String?
  state                 String?
  zipcode               Int?
  country               String?
  certifications        Json?
  socialMediaLinks      Json?
  profileDescription    String?
  portfolioImages       Json?
  coverPhoto            String?
  currentlyAvailable    Boolean?            @default(true)
  nextAvailable         String?
  termsAccepted         Boolean?
  flags                 Json?
  xp                    Int                 @default(0)
  level                 Int                 @default(1)
  rating                Int?
  assignedJobs          Json?
  cancelledJobs         Json?
  totalEarnings         Decimal             @default(0.00) @db.Decimal(10, 2)
  monthlyEarnings       Decimal             @default(0.00) @db.Decimal(10, 2)
  outstandingAmount     Decimal             @default(0.00) @db.Decimal(10, 2)
  withdrawableAmount    Decimal             @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  availabilityUpdatedAt DateTime?
  totalPenaltyDeducted  Decimal             @default(0.00) @db.Decimal(10, 2)
  totalPenaltyReceived  Decimal             @default(0.00) @db.Decimal(10, 2)
  freelancerCategory    String?
  skills                Json?
  languages             Json?
  cancellationStrikes   Int                 @default(0)
  cooldownExpiresAt     DateTime?
  workType              String?
  typeChangedAt         DateTime?
  chatThreads           ChatThread[]        @relation("FreelancerChatThreads")
  earnings              Earning[]
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedJobs_rel      Job[]               @relation("AssignedFreelancer")
  jobsCreated           Job[]               @relation("FreelancerJobs")
  paymentHistory        PaymentHistory[]
  penaltyLogs           PenaltyLog[]
  reviews               Review[]
  userEggs              UserEgg[]
  withdrawalRequests    WithdrawalRequest[]

  @@map("freelancers")
}

model Client {
  id                    String             @id @default(uuid())
  userId                String             @unique
  phase1Completed       Boolean            @default(false)
  phase2Completed       Boolean            @default(false)
  organizationType      String?
  companyName           String?
  city                  String?
  state                 String?
  zipcode               Int?
  country               String?
  profileDescription    String?
  termsAccepted         Boolean?
  wallet                Decimal            @default(0.00) @db.Decimal(10, 2)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  availableBalance      Decimal            @default(0.00) @db.Decimal(10, 2)
  reservedAmount        Decimal            @default(0.00) @db.Decimal(10, 2)
  availabilityUpdatedAt DateTime?
  currentlyAvailable    Boolean?           @default(true)
  nextAvailable         String?
  coverPhoto            String?
  pendingPenaltyAmount  Decimal?           @default(0) @db.Decimal(10, 2)
  totalPenaltyPaid      Decimal            @default(0.00) @db.Decimal(10, 2)
  addressLine1          String?
  addressLine2          String?
  adminOfferClaims      adminOfferClaims[]
  cashbackOffer         CashbackOffer[]
  chatThreads           ChatThread[]       @relation("ClientChatThreads")
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobsCreated           Job[]              @relation("ClientJobs")
  paymentHistory        PaymentHistory[]
  penaltyLogs           PenaltyLog[]
  reviews               Review[]

  @@map("clients")
}

model Job {
  id                                 String              @id @default(uuid())
  jobTitle                           String
  jobDescription                     String
  jobCategory                        String
  jobSubCategory                     String
  skillsRequired                     Json
  projectType                        String
  budgetType                         String
  budgetAmount                       Decimal             @db.Decimal(10, 2)
  clientId                           String
  paymentMethod                      String              @default("PLATFORM")
  birdFeeAmount                      Decimal?            @db.Decimal(10, 2)
  birdFeePaid                        Boolean             @default(false)
  assignedFreelancerId               String?
  createdBy                          String?
  serviceId                          String?
  jobStatus                          JobStatus           @default(OPEN)
  proposalCount                      Int                 @default(0)
  deadlineDate                       DateTime?
  assignedAt                         DateTime?
  attachedFiles                      Json?
  location                           String?
  latitude                           Decimal?            @db.Decimal(10, 8)
  longitude                          Decimal?            @db.Decimal(11, 8)
  isUrgent                           Boolean?            @default(false)
  createdAt                          DateTime            @default(now())
  updatedAt                          DateTime            @updatedAt
  amountPaid                         Decimal?            @default(0.00) @db.Decimal(10, 2)
  isAmountReserved                   Boolean             @default(false)
  paymentStatus                      PaymentStatus       @default(PENDING)
  completedAt                        DateTime?
  cashbackOfferId                    String?
  discountAmount                     Decimal?            @default(0) @db.Decimal(10, 2)
  deleted                            Boolean             @default(false)
  clientPenaltyAmount                Decimal?            @default(0) @db.Decimal(10, 2)
  cancelledAt                        DateTime?
  applicationDeadline                DateTime?
  applicationExtended                Boolean             @default(false)
  workDurationDays                   Int?
  workDeadline                       DateTime?
  confirmedAt                        DateTime?
  arrivedAt                          DateTime?
  otpCode                            String?             @db.VarChar(6)
  otpVerifiedAt                      DateTime?
  submittedWorkData                  Json?
  revisionCount                      Int                 @default(0)
  clientReviewPeriodExpiresAt        DateTime?
  freelancerGracePeriodExpiresAt     DateTime?
  cancellationReason                 String?
  priceChangeRequested               Decimal?            @db.Decimal(10, 2)
  priceChangeReason                  String?
  applicationDeadlineOriginal        DateTime?
  applicationExtensionCount          Int                 @default(0)
  negotiatedAmount                   Decimal?            @db.Decimal(10, 2)
  travelStartedAt                    DateTime?
  jobStartTime                       DateTime?
  workCompletedAt                    DateTime?
  clientConfirmedWorkAt              DateTime?
  postOtpCancellationWindowExpiresAt DateTime?
  clientReviewReminderSentAt         DateTime?
  clientReviewFinalReminderSentAt    DateTime?
  includedRevisions                  Int                 @default(2)
  priceChangeAcceptedAt              DateTime?
  chatThreads                        ChatThread[]        @relation("JobChatThreads")
  earnings                           Earning[]
  bookmarks                          JobBookmark[]
  statusHistory                      JobStatusHistory[]
  assignedFreelancer                 Freelancer?         @relation("AssignedFreelancer", fields: [assignedFreelancerId], references: [id], map: "jobsAssignedFreelancerFkey")
  createdByFreelancer                Freelancer?         @relation("FreelancerJobs", fields: [createdBy], references: [id], map: "jobsCreatedByFreelancerFkey")
  service                            Service?            @relation("JobService", fields: [serviceId], references: [id], map: "jobsServiceIdFkey")
  client                             Client              @relation("ClientJobs", fields: [clientId], references: [id], onDelete: Cascade)
  messages                           Message[]
  penaltySourceJobs                  PenaltyLog[]        @relation("PenaltySourceJob")
  penaltyLogs                        PenaltyLog[]
  reviews                            Review[]
  walletTransactions                 WalletTransaction[]

  @@index([applicationDeadline])
  @@index([assignedFreelancerId])
  @@index([clientId])
  @@index([createdBy])
  @@index([serviceId])
  @@index([workDeadline])
  @@map("jobs")
}

model Message {
  id             String      @id @default(uuid())
  senderId       String
  receiverId     String
  jobId          String?
  messageContent String
  messageType    String      @default("text")
  messageData    Json        @default("{}")
  attachments    Json?
  isRead         Boolean     @default(false)
  senderType     String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  chatThreadId   String?
  chatThread     ChatThread? @relation("ChatThreadMessages", fields: [chatThreadId], references: [id])
  job            Job?        @relation(fields: [jobId], references: [id])
  receiver       User        @relation("UserReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  sender         User        @relation("UserSender", fields: [senderId], references: [id], onDelete: Cascade)
  userMedia      UserMedia[]

  @@index([chatThreadId])
  @@index([createdAt])
  @@index([jobId])
  @@index([receiverId])
  @@index([senderId])
  @@map("messages")
}

model Review {
  id            String      @id @default(uuid())
  reviewerId    String
  revieweeId    String
  jobId         String?
  rating        Int
  ratingDetails Json?
  reviewText    String?
  reviewType    String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  freelancerId  String?
  clientId      String?
  client        Client?     @relation(fields: [clientId], references: [id])
  freelancer    Freelancer? @relation(fields: [freelancerId], references: [id])
  job           Job?        @relation(fields: [jobId], references: [id])
  reviewee      User        @relation("UserReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer      User        @relation("UserReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([revieweeId])
  @@index([reviewerId])
  @@map("reviews")
}

model Earning {
  id           String        @id @default(uuid())
  freelancerId String
  jobId        String?
  amount       Decimal       @db.Decimal(10, 2)
  earningType  String
  description  String?
  status       EarningStatus @default(PENDING)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  freelancer   Freelancer    @relation(fields: [freelancerId], references: [id], onDelete: Cascade)
  job          Job?          @relation(fields: [jobId], references: [id])

  @@index([freelancerId])
  @@index([jobId])
  @@index([status])
  @@map("earnings")
}

model WithdrawalRequest {
  id           String           @id @default(uuid())
  freelancerId String
  amount       Decimal          @db.Decimal(10, 2)
  bankDetails  Json
  status       WithdrawalStatus @default(PENDING)
  processedAt  DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  freelancer   Freelancer       @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([freelancerId])
  @@index([status])
  @@map("withdrawalRequests")
}

model PaymentHistory {
  id            String        @id @default(uuid())
  clientId      String?
  jobId         String?
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod String
  transactionId String?
  status        PaymentStatus @default(PENDING)
  description   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  freelancerId  String?
  client        Client?       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  freelancer    Freelancer?   @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([freelancerId])
  @@index([jobId])
  @@index([status])
  @@map("paymentHistory")
}

model WalletTransaction {
  id              String          @id @default(uuid())
  userId          String
  userType        String
  jobId           String?
  transactionType TransactionType
  amount          Decimal         @db.Decimal(10, 2)
  balanceBefore   Decimal         @db.Decimal(10, 2)
  balanceAfter    Decimal         @db.Decimal(10, 2)
  description     String?
  referenceId     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  job             Job?            @relation(fields: [jobId], references: [id])
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([transactionType])
  @@index([userId])
  @@map("walletTransactions")
}

model PenaltyLog {
  id             String      @id @default(uuid())
  jobId          String
  clientId       String
  freelancerId   String?
  penaltyType    String
  amount         Decimal     @db.Decimal(10, 2)
  status         String      @default("PENDING")
  description    String?
  createdByJobId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  client         Client      @relation(fields: [clientId], references: [id])
  sourceJob      Job?        @relation("PenaltySourceJob", fields: [createdByJobId], references: [id])
  freelancer     Freelancer? @relation(fields: [freelancerId], references: [id])
  job            Job         @relation(fields: [jobId], references: [id])

  @@index([clientId])
  @@index([freelancerId])
  @@index([jobId])
  @@index([penaltyType])
  @@map("penaltyLogs")
}

model UserEgg {
  id           String     @id @default(uuid())
  freelancerId String
  eggType      String
  quantity     Int        @default(1)
  earnedFrom   String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  freelancer   Freelancer @relation(fields: [freelancerId], references: [id], onDelete: Cascade)

  @@index([eggType])
  @@index([freelancerId])
  @@map("userEggs")
}

model BlockedUser {
  id          String   @id @default(uuid())
  blockerId   String
  blockedId   String
  blockerType String
  blockedType String
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@index([blockerId])
  @@map("blockedUsers")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  userType    String
  title       String
  message     String
  type        String
  data        Json?
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  scheduledAt DateTime?
  status      String    @default("SENT")

  @@index([createdAt])
  @@index([isRead])
  @@index([scheduledAt])
  @@index([status])
  @@index([userId])
  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())
  userId    String
  userType  String
  token     String   @unique
  platform  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([token])
  @@index([userId])
  @@map("pushTokens")
}

model FileManagement {
  id           String   @id @default(uuid())
  fileName     String
  originalName String
  fileUrl      String
  fileSize     Int
  mimeType     String
  uploadedBy   String
  uploaderType String
  category     String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  jobId        String?
  receiverId   String?

  @@index([category])
  @@index([createdAt])
  @@index([jobId])
  @@index([receiverId])
  @@index([uploadedBy])
  @@map("fileManagement")
}

model JobBookmark {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("jobBookmarks")
}

model DeleteRequest {
  id          String              @id @default(uuid())
  userId      String
  userType    String
  reason      String?
  status      DeleteRequestStatus @default(PENDING)
  processedAt DateTime?
  processedBy String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([status])
  @@index([userId])
  @@map("deleteRequests")
}

model Service {
  id                String             @id @default(uuid())
  name              String             @unique
  category          ServiceCategory
  description       String?
  imageUrl          String?
  isActive          Boolean            @default(true)
  priorityConfig    Json?
  birdFee           Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  adminOffers       adminOffers[]
  cashbackOffers    CashbackOffer[]
  homePromos        HomePromo[]
  jobs              Job[]              @relation("JobService")
  suggestedServices SuggestedService[]

  @@index([category])
  @@index([isActive])
  @@map("services")
}

model SuggestedService {
  id               String   @id @default(uuid())
  userId           String
  serviceName      String
  description      String?
  images           Json?
  status           String   @default("pending")
  matchedServiceId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  matchedService   Service? @relation(fields: [matchedServiceId], references: [id])
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matchedServiceId])
  @@index([status])
  @@index([userId])
  @@map("suggestedServices")
}

model HomePromo {
  id                    String             @id @default(uuid())
  placement             HomePromoPlacement
  title                 String             @db.VarChar(200)
  subtitle              String?
  badge                 String?            @db.VarChar(50)
  ctaLabel              String?            @db.VarChar(80)
  imageUrl              String?
  backgroundColor       String?            @db.VarChar(20)
  textColor             String?            @db.VarChar(20)
  accentColor           String?            @db.VarChar(20)
  sortOrder             Int                @default(0)
  isActive              Boolean            @default(true)
  startsAt              DateTime?
  endsAt                DateTime?
  serviceId             String?
  serviceType           String?            @db.VarChar(20)
  prefillJobTitle       String?            @db.VarChar(200)
  prefillJobDescription String?
  prefillBudget         String?            @db.VarChar(40)
  prefillJobType        String?            @db.VarChar(20)
  prefillPaymentMethod  String?            @db.VarChar(20)
  prefillSkills         Json?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  service               Service?           @relation(fields: [serviceId], references: [id])

  @@index([placement, isActive, sortOrder])
  @@index([serviceId])
  @@map("homePromos")
}

model ChatThread {
  id                 String               @id @default(uuid())
  jobId              String
  freelancerId       String
  clientId           String
  characterLimit     Int                  @default(200)
  isAccepted         Boolean              @default(false)
  status             ChatStatus           @default(PENDING)
  createdAt          DateTime             @default(now())
  deadline           DateTime?
  updatedAt          DateTime             @updatedAt
  usedStorage        BigInt               @default(0)
  storageLimit       BigInt               @default(3221225472)
  clientOffer        Decimal?             @db.Decimal(10, 2)
  freelancerOffer    Decimal?             @db.Decimal(10, 2)
  agreedAmount       Decimal?             @db.Decimal(10, 2)
  clientDays         Int?
  freelancerDays     Int?
  agreedDays         Int?
  client             Client               @relation("ClientChatThreads", fields: [clientId], references: [id])
  freelancer         Freelancer           @relation("FreelancerChatThreads", fields: [freelancerId], references: [id])
  job                Job                  @relation("JobChatThreads", fields: [jobId], references: [id])
  messages           Message[]            @relation("ChatThreadMessages")
  negotiationHistory NegotiationHistory[] @relation("NegotiationThreadHistory")

  @@unique([jobId, freelancerId, clientId])
  @@index([clientId])
  @@index([freelancerId])
  @@index([jobId])
  @@map("chatThreads")
}

model NegotiationHistory {
  id             String     @id @default(uuid())
  chatThreadId   String
  jobId          String
  senderId       String
  senderType     String
  offerType      String
  amount         Decimal    @db.Decimal(10, 2)
  previousAmount Decimal?   @db.Decimal(10, 2)
  note           String?
  createdAt      DateTime   @default(now())
  days           Int?
  previousDays   Int?
  chatThread     ChatThread @relation("NegotiationThreadHistory", fields: [chatThreadId], references: [id])

  @@index([chatThreadId])
  @@index([createdAt])
  @@index([jobId])
  @@map("negotiationHistory")
}

model UserMedia {
  id         String   @id @default(uuid())
  fileName   String
  fileSize   Int
  mimeType   String
  location   String
  path       String
  uploaderId String
  threadId   String
  messageId  String
  expiresAt  DateTime
  isExpired  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  message    Message  @relation(fields: [messageId], references: [id])

  @@index([expiresAt])
  @@index([threadId])
  @@index([messageId])
  @@map("userMedia")
}

model CashbackOffer {
  id               String                  @id
  amount           Float
  amountType       CashbackOfferAmountType
  discovered       Boolean                 @default(false)
  used             Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime
  clientId         String
  minBooking       Float                   @default(0)
  maxDiscount      Float?
  reservedJobId    String?
  code             String?                 @db.VarChar(50)
  serviceId        String?
  adminOfferClaims adminOfferClaims[]
  clients          Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "CashbackOfferClientIdFkey")
  services         Service?                @relation(fields: [serviceId], references: [id], map: "CashbackOfferServiceIdFkey")

  @@index([clientId])
  @@index([serviceId])
  @@map("cashbackOffers")
}

model OtpVerification {
  id        String    @id @default(uuid())
  mobile    String    @db.VarChar(255)
  code      String?   @db.VarChar(6)
  expiresAt DateTime?
  verified  Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([mobile])
  @@index([expiresAt])
  @@map("otpVerifications")
}

model JobStatusHistory {
  id        String   @id @default(uuid())
  jobId     String
  status    String
  changedBy String?
  userType  String?
  action    String?
  reason    String?
  metadata  Json?
  createdAt DateTime @default(now())
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([jobId])
  @@map("jobStatusHistory")
}

model adminOfferClaims {
  id              String         @id
  adminOfferId    String
  clientId        String
  revealedAt      DateTime?
  cashbackOfferId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  adminOffers     adminOffers    @relation(fields: [adminOfferId], references: [id], onDelete: Cascade, map: "AdminOfferClaimAdminOfferIdFkey")
  cashbackOffers  CashbackOffer? @relation(fields: [cashbackOfferId], references: [id], map: "AdminOfferClaimCashbackOfferIdFkey")
  clients         Client         @relation(fields: [clientId], references: [id], onDelete: Cascade, map: "AdminOfferClaimClientIdFkey")

  @@unique([adminOfferId, clientId])
  @@index([clientId])
}

model adminOffers {
  id               String                  @id
  code             String                  @db.VarChar(50)
  serviceId        String
  amount           Float
  amountType       CashbackOfferAmountType
  minBooking       Float                   @default(0)
  maxDiscount      Float?
  isActive         Boolean                 @default(true)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime
  placement        HomePromoPlacement      @default(OFFER_CARD)
  adminOfferClaims adminOfferClaims[]
  services         Service                 @relation(fields: [serviceId], references: [id], onDelete: Cascade, map: "AdminOfferServiceIdFkey")

  @@index([isActive])
  @@index([serviceId])
}

model twoFactorChallenges {
  id         String    @id
  userId     String
  purpose    String    @db.VarChar(20)
  codeHash   String    @db.VarChar(255)
  deviceId   String?   @db.VarChar(255)
  deviceName String?   @db.VarChar(255)
  platform   String?   @db.VarChar(50)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  users      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model userDevices {
  id          String   @id
  userId      String
  deviceId    String   @db.VarChar(255)
  deviceName  String?  @db.VarChar(255)
  platform    String?  @db.VarChar(50)
  lastLoginAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  users       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

